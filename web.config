<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!--
      HttpPlatformHandler → waitress στο 127.0.0.1, οπότε χωρίς rewrite
      το Flask βλέπει μόνο loopback. Περνάμε την πραγματική IP πελάτη.
      Τα HTTP_X_FORWARDED_FOR / HTTP_X_REAL_IP είναι unlocked στο APPHOST.
    -->
    <rewrite>
      <rules>
        <rule name="SetClientIPForPython" stopProcessing="false">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REMOTE_ADDR}" pattern=".+" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_REAL_IP" value="{REMOTE_ADDR}" />
          </serverVariables>
          <action type="None" />
        </rule>
      </rules>
    </rewrite>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="C:\inetpub\wwwroot\erganios\venv\Scripts\python.exe"
                  arguments="-m waitress --listen=127.0.0.1:%HTTP_PLATFORM_PORT% --threads=8 wsgi:app"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\iis-stdout"
                  startupTimeLimit="120"
                  startupRetryCount="10"
                  requestTimeout="00:05:00">
      <environmentVariables>
        <environmentVariable name="PYTHONUTF8" value="1" />
        <environmentVariable name="PYTHONIOENCODING" value="utf-8" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
